<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Example: No Propulsion / Payload Mass and Power Only (no mass_total)
     sc_type=1 (explicit).  mass_total is NOT provided; the evolver derives
     total mass from the payload mass fraction scaling.
     mass_payload=750 kg with power_payload=700 W is representative of a
     medium-class Earth-observation instrument suite (~3000 kg platform class).
     Minimal attitude-control delta-v only. -->
<Satellite_parameters dcep_version="20191026" dcep_show="False">
	<input_case dcep_show="False">
		<sc_type dcep_name="Spacecraft type" dcep_unit="-" dcep_description="1=No propulsion, 2=LEO, 3=HEO/GEO, 4=Planetary">1</sc_type>
		<mass_payload dcep_name="Payload Mass" dcep_unit="kg" dcep_description="Payload subsystem mass (no total mass provided; total derived from payload fraction)">750</mass_payload>
		<power_payload dcep_name="Payload Power" dcep_unit="W" dcep_description="Power consumed by the payload subsystem">700</power_payload>
		<deltav dcep_name="Required Delta v" dcep_unit="m/s" dcep_description="Minimal attitude-control / momentum-dumping budget">30</deltav>
		<propulsion_power dcep_name="Available Power" dcep_unit="W" dcep_description="Power available for propulsion system">2300</propulsion_power>
		<mission_duration dcep_name="Total Mission Duration" dcep_unit="years" dcep_description="Total mission lifetime">3</mission_duration>
	</input_case>
</Satellite_parameters>
