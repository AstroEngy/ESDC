<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Simulation_parameters dcep_version="20192023">
	<defaults>
		<orbit_min>350</orbit_min>
		<orbit_max>45000</orbit_max>
		<orbit>
			<no_propulsion>550</no_propulsion>
			<Low_Earth>1000</Low_Earth>
			<High_Earth>35786</High_Earth>
		</orbit>
		<!-- Default mission lifetimes applied when no mission_duration or maneuver_duration_max
		     is specified in the input case. Values are per spacecraft type (sc_type 1-4).
		     Sources:
		       sc_type 1 (No Propulsion / LEO passive): SMAD (Wertz 2011), typical CubeSat 2-5 yr
		       sc_type 2 (LEO, dv <= 2000 m/s)        : SMAD Table 1-3, median LEO operational lifetime
		       sc_type 3 (GEO/HEO, dv <= 4300 m/s)    : ECSS-E-ST-10-04C, GEO commercial design life
		       sc_type 4 (Planetary, dv > 4300 m/s)    : representative of Cassini 13yr, Rosetta/New Horizons 10yr
		     propulsion_time_fraction: fraction of mission duration used for propulsion burns.
		       Source: SMAD 2011 p.693 ff., typical EP station-keeping duty cycles 5-20%; 10% used. -->
		<mission_duration_years>
			<sc_type_1>3</sc_type_1>
			<sc_type_2>5</sc_type_2>
			<sc_type_3>15</sc_type_3>
			<sc_type_4>10</sc_type_4>
		</mission_duration_years>
		<propulsion_time_fraction>0.10</propulsion_time_fraction>
	</defaults>
	<evolver>
		<fitness_criterion>maximize_mass_margin</fitness_criterion>
		<random_seed>42</random_seed>
		<seed_points> 18 </seed_points>
		<fitness_landscape_resolution> 50 </fitness_landscape_resolution>
		<minimal_step_size>0.00001</minimal_step_size>
		<max_jump_range>20</max_jump_range>
		<n_fails_to_converge>10</n_fails_to_converge>
		<n_bad_seed_to_converge>20</n_bad_seed_to_converge>
		<n_verbosity>10</n_verbosity>
	</evolver> 
	<output>
		<CLI>
			<n_verbosity>10</n_verbosity>
		</CLI>
		<xml>
			<full_history>0</full_history>
			<optimal_candidates>1</optimal_candidates>
		</xml>
		<plots>
			<system>1</system>
			<components>1</components>
		</plots>
	</output>
</Simulation_parameters>

